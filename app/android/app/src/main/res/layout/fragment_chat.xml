<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06080F">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Boot splash: covers the WebView while the daemon cold-starts so the
         system ERR_CONNECTION_REFUSED error page (page-load retry window)
         never flashes. A single breathing wordmark — the WUI header's own
         connected-state visual, so the splash and the loaded page read as
         one continuous surface. -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_bg">

        <TextView
            android:id="@+id/splashMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="GBot"
            android:textColor="@color/splash_accent"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02" />

        <!-- Escape hatch for an unreachable REMOTE target (the WUI header
             with its target switch is gone on an error page). Hidden until
             the retry budget is exhausted while wui_target=remote; a click
             flips the pref back to local and reloads. -->
        <TextView
            android:id="@+id/backToLocal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="120dp"
            android:background="?android:attr/selectableItemBackground"
            android:padding="12dp"
            android:text="切回本地"
            android:textColor="@color/splash_danger"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
