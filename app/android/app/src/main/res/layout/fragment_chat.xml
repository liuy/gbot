<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06080F">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Boot splash: covers the WebView while the daemon cold-starts so the
         system ERR_CONNECTION_REFUSED error page (page-load retry window)
         never flashes. A single breathing wordmark — the WUI header's own
         connected-state visual, so the splash and the loaded page read as
         one continuous surface. -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_bg">

        <TextView
            android:id="@+id/splashMark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="GBot"
            android:textColor="@color/splash_accent"
            android:textSize="32sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02" />

        <!-- Endpoint pills: rendered only when ≥1 remote endpoint is configured.
             Local pill first (green dot escape hatch), then remotes in stored
             order. topMargin + width set in code (fractional geometry). -->
        <LinearLayout
            android:id="@+id/splashPills"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Visible only after the retry budget is exhausted. -->
        <TextView
            android:id="@+id/splashTapHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="96dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/splash_tap_retry"
            android:textColor="@color/splash_danger"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

</FrameLayout>
